# The image that builds and releases tronko reference databases
# (scripts/release_tronko.sh). It holds one tronko commit, compiled, and every
# outside tool the build runs, at fixed versions. See "Build a database from an
# rCRUX release" in README.md; ops/release/launch.sh runs it on a VM.
#
# linux/amd64 only, on purpose: the alignment and tree tools give different
# results on arm64, so releases come from one platform. An arm64 host (Apple
# Silicon) runs it under emulation, which is fine for a small test and far too
# slow for a real marker.
#
#   docker build -f Dockerfile.release --build-arg TRONKO_REF=<commit or tag> -t tronko-release .
#
# The tronko code comes from TRONKO_REF, not from the build context, so the
# commit recorded in a release's metadata is the code in the image.
FROM --platform=linux/amd64 ubuntu:24.04

ARG TRONKO_REF
ARG TRONKO_REPO_URL=https://github.com/eDNA-Explorer/tronko.git
# Outside tools built from source. The tree tools, RAxML and bwa are Ubuntu
# 24.04's packages: FastTree 2.1.11, VeryFastTree 4.0.3, RAxML 8.2.12, bwa 0.7.17.
ARG FAMSA_VERSION=v1.6.1
ARG NEWICK_UTILS_COMMIT=da121155a977197cab9fbb15953ca1b40b11eb87

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential git ca-certificates perl python3 zlib1g-dev libzstd-dev \
        clang-19 libomp-19-dev libdeflate-dev autoconf automake libtool cmake flex bison \
        bwa raxml fasttree veryfasttree \
    && rm -rf /var/lib/apt/lists/* \
    # tronko-build runs these by exactly these names
    && { command -v FastTree >/dev/null || ln -s "$(command -v fasttree)" /usr/local/bin/FastTree; } \
    && { command -v raxmlHPC-PTHREADS >/dev/null \
         || ln -s "$(command -v raxmlHPC-PTHREADS-AVX || command -v raxmlHPC-PTHREADS-SSE3)" /usr/local/bin/raxmlHPC-PTHREADS; }

# FAMSA
RUN git clone --quiet --depth 1 --branch "$FAMSA_VERSION" https://github.com/refresh-bio/FAMSA /tmp/famsa \
    && make -C /tmp/famsa -j"$(nproc)" \
    && cp /tmp/famsa/famsa /usr/local/bin/ && rm -rf /tmp/famsa

# nw_reroot (newick-utils)
RUN git clone --quiet https://github.com/tjunier/newick_utils /tmp/nw && cd /tmp/nw \
    && git checkout --quiet "$NEWICK_UTILS_COMMIT" && autoreconf -fi \
    && CFLAGS="-O2 -fcommon" ./configure --without-guile --without-lua --disable-shared \
    && make -j"$(nproc)" -C src nw_reroot && cp src/nw_reroot /usr/local/bin/ && cd / && rm -rf /tmp/nw

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv

# tronko at TRONKO_REF: tronko-build, tronko-convert, ancestralclust, tronko-assign
# and the BWA-MEM3 release tronko-assign pins; then the scripts' Python (dvc).
RUN [ -n "$TRONKO_REF" ] || { echo "pass --build-arg TRONKO_REF=<commit or tag>" >&2; exit 1; } \
    && git clone --quiet "$TRONKO_REPO_URL" /opt/tronko && cd /opt/tronko \
    && git checkout --quiet --detach "$TRONKO_REF" \
    && for tool in tronko-build tronko-convert ancestralclust tronko-assign; do make -s -C "$tool" || exit 1; done \
    && make -s -C tronko-assign bwa-mem3 && rm -rf tronko-assign/build \
    && uv sync --quiet --frozen --no-dev --project scripts \
    && git config --system --add safe.directory '*'

ENV PATH=/opt/tronko/scripts/.venv/bin:/opt/tronko/tronko-build:/opt/tronko/tronko-convert:/opt/tronko/ancestralclust:/opt/tronko/tronko-assign:$PATH \
    PYTHON=/opt/tronko/scripts/.venv/bin/python

WORKDIR /work
ENTRYPOINT ["/opt/tronko/scripts/release_tronko.sh"]
CMD ["--help"]
