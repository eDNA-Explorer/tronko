 	return max;
 }
 
+/* Recorder of ksw_extend2 calls (tronko-assign/tests/tools/ksw_record.patch). With KSW_DUMP
+ * set, every KSW_DUMP_EVERY-th call (default 100; calls 0, 100, 200, ...) is appended to that
+ * file: 20 int32 (0x4457534b "KSWD", call site, qlen, tlen, m, o_del, e_del, o_ins, e_ins, w,
+ * end_bonus, zdrop, h0, score, qle, tle, gtle, gscore, max_off, 0), then m * m bytes of mat,
+ * qlen bytes of query, tlen bytes of target. Run at one thread so that the call order is fixed. */
+#include <stdio.h>
+#include <pthread.h>
+__thread int ksw_dump_site = 0; /* set by mem_chain2aln: 1 = left, 2 = right, | (band try << 4) */
+static pthread_mutex_t ksw_dump_lock = PTHREAD_MUTEX_INITIALIZER;
+static FILE *ksw_dump_fp = 0;
+static long ksw_dump_every = 100, ksw_dump_calls = 0;
+static void ksw_dump_close(void) { if (ksw_dump_fp) fclose(ksw_dump_fp); }
+static void ksw_dump_init(void)
+{
+	const char *p = getenv("KSW_DUMP"), *e = getenv("KSW_DUMP_EVERY");
+	if (e && atol(e) > 0) ksw_dump_every = atol(e);
+	if (p) ksw_dump_fp = fopen(p, "wb");
+	atexit(ksw_dump_close);
+}
+static pthread_once_t ksw_dump_once = PTHREAD_ONCE_INIT;
+int ksw_extend2(int qlen, const uint8_t *query, int tlen, const uint8_t *target, int m, const int8_t *mat, int o_del, int e_del, int o_ins, int e_ins, int w, int end_bonus, int zdrop, int h0, int *_qle, int *_tle, int *_gtle, int *_gscore, int *_max_off)
+{
+	int qle, tle, gtle, gscore, max_off, score;
+	pthread_once(&ksw_dump_once, ksw_dump_init);
+	score = ksw_extend2_recorded(qlen, query, tlen, target, m, mat, o_del, e_del, o_ins, e_ins, w, end_bonus, zdrop, h0, &qle, &tle, &gtle, &gscore, &max_off);
+	if (ksw_dump_fp) {
+		pthread_mutex_lock(&ksw_dump_lock);
+		if (ksw_dump_calls++ % ksw_dump_every == 0) {
+			int32_t hdr[20] = { 0x4457534b, ksw_dump_site, qlen, tlen, m, o_del, e_del, o_ins, e_ins, w,
+				end_bonus, zdrop, h0, score, qle, tle, gtle, gscore, max_off, 0 };
+			fwrite(hdr, 4, 20, ksw_dump_fp);
+			fwrite(mat, 1, m * m, ksw_dump_fp);
+			fwrite(query, 1, qlen, ksw_dump_fp);
+			fwrite(target, 1, tlen, ksw_dump_fp);
+		}
+		pthread_mutex_unlock(&ksw_dump_lock);
+	}
+	if (_qle) *_qle = qle;
+	if (_tle) *_tle = tle;
+	if (_gtle) *_gtle = gtle;
+	if (_gscore) *_gscore = gscore;
+	if (_max_off) *_max_off = max_off;
+	return score;
+}
+
 int ksw_extend(int qlen, const uint8_t *query, int tlen, const uint8_t *target, int m, const int8_t *mat, int gapo, int gape, int w, int end_bonus, int zdrop, int h0, int *qle, int *tle, int *gtle, int *gscore, int *max_off)
 {
 	return ksw_extend2(qlen, query, tlen, target, m, mat, gapo, gape, gapo, gape, w, end_bonus, zdrop, h0, qle, tle, gtle, gscore, max_off);
